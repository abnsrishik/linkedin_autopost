# ---- Telegram (from @BotFather) ----
# Create a bot: https://t.me/BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Get your user id: https://t.me/userinfobot
TELEGRAM_USER_ID=

# ---- Groq LLM (https://console.groq.com) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- LinkedIn Dev App (https://www.linkedin.com/developers/apps) ----
# Products to enable in the app:
#   - "Share on LinkedIn"        (grants w_member_social)
#   - "Sign in with LinkedIn"   (OpenID Connect, grants openid profile)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must EXACTLY match the "Authorized redirect URLs" in the LinkedIn dev app.
LINKEDIN_REDIRECT_URI=http://localhost:8080/callback
# Posts API version. Update when LinkedIn rolls a new one. Current as of build.
LINKEDIN_VERSION=202604

# ---- Web Search Add-on (Tavily or Google SERP) ----
# Selects which provider powers /trending and /news <topic>.
# Allowed values: tavily | serp
SEARCH_PROVIDER=tavily

# Tavily — https://tavily.com  (preferred; has a dedicated /news endpoint,
# returns fresh, LLM-ready article content per result). Get a key from
# the Tavily dashboard after signing up.
TAVILY_API_KEY=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

# SerpAPI / Google SERP — https://serpapi.com  (alternative; uses Google
# News via tbm=nws. Less curated but works with any SERP-API key.)
# Only required if SEARCH_PROVIDER=serp.
SERP_API_KEY=15d21d359e3238dd72319a1f4971fc21d7068e8d048338f50bb945b7c4484c42

# How long the news cache stays fresh before /trending or /news re-queries
# the provider. Default 1800s (30 min).
SEARCH_CACHE_TTL_SECONDS=1800

# Default number of items returned by /trending and /news <topic>. 1-10.
SEARCH_DEFAULT_NUM=8
