# ---- Telegram (from @BotFather) ----
# Create a bot: https://t.me/BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Get your user id: https://t.me/userinfobot
TELEGRAM_USER_ID=

# ---- Groq LLM (https://console.groq.com) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- LinkedIn Dev App (https://www.linkedin.com/developers/apps) ----
# Products to enable in the app:
#   - "Share on LinkedIn"        (grants w_member_social)
#   - "Sign in with LinkedIn"   (OpenID Connect, grants openid profile)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must EXACTLY match the "Authorized redirect URLs" in the LinkedIn dev app.
LINKEDIN_REDIRECT_URI=http://localhost:8080/callback
# Posts API version. Update when LinkedIn rolls a new one. Current as of build.
LINKEDIN_VERSION=202604
